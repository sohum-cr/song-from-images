# Server Configuration
PORT=3001

# Anthropic API Key (optional - can be provided from frontend)
ANTHROPIC_API_KEY=your_api_key_here

# CORS Configuration (comma-separated list of allowed origins)
# Examples: http://localhost:5173,https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
